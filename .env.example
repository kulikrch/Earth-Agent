# Earth-Agent Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: OpenAI API (for langchain_gpt4o_dev.py and other GPT-based scripts)
# ============================================================================
OPENAI_API_KEY=""

# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Proxy for OpenAI requests (if behind corporate firewall)
OPENAI_PROXY=""
HTTP_PROXY=""
PROXY_URL=""

# ============================================================================
# REQUIRED: OpenStreetMap API (for use with osm-mcp)
# ============================================================================

OSM_MCP_PATH="/path/to/osm-mcp"  # Update this to the actual path of your osm-mcp installation

GEE_SERVICE_ACCOUNT_KEY="/path/to/your/service-account-key.json"  # Update this to the actual path of your GEE service account key

REDIS_URL="redis://localhost:6379" # Update for use redis cache
